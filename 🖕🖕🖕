// Main entry — run both functions
// ──────────────────────────────────────────────

export async function main(): Promise<void> {
	// All Worker names = stores + prefectures (deduplicated)
	const allWorkerNames = [
		...new Set([...storeWorkerNames, ...prefectureWorkerNames]),
	];

	console.log(
		`🚀 Creating ${allWorkerNames.length} Workers (clone of "sushi")...`,
	);
	await addWorkers(allWorkerNames);

	// Pages subdomains = same prefecture names as subdomains on sushi.software
	const pagesSubdomains = prefectureWorkerNames;

	console.log(`🌐 Adding ${pagesSubdomains.length} Pages custom domains...`);
	await addPages(pagesSubdomains, "sushi.software", "kamaji-project");

	console.log("✅ Done!");
}

// Run if called directly
if (require.main === module) {
	main().catch((err) => {
		console.error("Fatal:", err);
		process.exit(1);
	});
